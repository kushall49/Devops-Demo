# ============================================================
# ENVIRONMENT VARIABLES - Backend Configuration
# Copy this file to .env and fill in your values.
#
# NEVER commit .env to Git! It contains secrets.
# This .env.example file is safe to commit.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB Connection ---
# Local development:
MONGO_URI=mongodb://localhost:27017/smartcalendar
# Docker Compose (uses service name 'mongodb'):
# MONGO_URI=mongodb://mongodb:27017/smartcalendar

# --- JWT Secret ---
# A long random string used to sign JWT tokens.
# IMPORTANT: Change this to a strong random value in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-long

# --- CORS ---
# The URL of your frontend application
FRONTEND_URL=http://localhost:3000
